  "vo": [
   {
    "t0": 0.1,
    "t1": 2.9,
    "line": "بمحرك سيارتك تصير… عشرات الانفجارات بالثانية!"
   },
   {
    "t0": 3.2,
    "t1": 5.5,
    "line": "خلّي نفتح المحرك… ونشوف."
   },
   {
    "t0": 8.1,
    "t1": 12,
    "line": "أول شي السحب: البستن ينزل، وبلف السحب ينفتح… فيدخل هوا وبانزين."
   },
   {
    "t0": 12.3,
    "t1": 16.2,
    "line": "بعدين الضغط: البلوف تتسكر، والبستن يصعد ويضغط الخليط."
   },
   {
    "t0": 16.5,
    "t1": 20.4,
    "line": "وهنا الانفجار: البوجي يقدح شرارة، والخليط ينفجر ويدفع البستن لجوه بقوة."
   },
   {
    "t0": 20.7,
    "t1": 24.6,
    "line": "وآخر شي العادم: بلف العادم ينفتح، والبستن يطلّع الدخان."
   },
   {
    "t0": 24.9,
    "t1": 28.8,
    "line": "وهالدورة تتكرر… مئات وحتى آلاف المرات بالدقيقة."
   },
   {
    "t0": 29.1,
    "t1": 32.5,
    "line": "والكرنك يحوّل هالحركة لدوران… يوصل للعجلات."
   }
  ]
 },
