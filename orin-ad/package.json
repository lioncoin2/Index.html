{
  "name": "orin-ad",
  "private": true,
  "description": "Orin — 30s vertical motion-graphics ad (HTML + GSAP, rendered with Playwright + ffmpeg)",
  "type": "module",
  "scripts": {
    "preview": "python3 -m http.server 8000",
    "render": "node render/render.mjs",
    "render:30": "node render/render.mjs --fps 30",
    "audio": "node render/render.mjs --cues-only && python3 render/soundtrack.py out/cues.json out/soundtrack.wav",
    "render:v4": "node render/render.mjs --page v4.html --shutter 5",
    "render:v5": "node render/render.mjs --page v5.html --shutter 5",
    "render:v5-iq": "node render/render.mjs --page v5-iq.html --shutter 5",
    "render:v6": "node render/render.mjs --page v6.html --shutter 5",
    "render:v7": "node render/render.mjs --page v7.html --shutter 5",
    "vo:v7": "python3 render/add_vo.py"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "sharp": "^0.35.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
